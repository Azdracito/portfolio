---

<section class="resume-section" id="projects">
    <div class="resume-section-content fade-in">
        <h2 class="section-heading">Projets</h2>

        <div class="projects-grid">
            {
                projects.map((p) => (
                    <a
                        class="project-card"
                        href={p.url}
                        target="_blank"
                        rel="noopener"
                        aria-label={p.title}
                    >
                        <div class="card-img-wrap">
                            <img
                                src={`/assets/img/projects/${p.img}`}
                                alt={p.title}
                                loading="lazy"
                            />
                            <span class="card-title">{p.title}</span>
                        </div>
                        <span class="card-badge" set:html={externalLinkIcon} />
                    </a>
                ))
            }
        </div>
    </div>
</section>
