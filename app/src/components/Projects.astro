---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/img/projects/*.webp',
    { eager: true }
);
const imageMap = Object.fromEntries(
    Object.entries(imageModules).map(([path, mod]) => [path.split('/').pop()!, mod.default])
);
---

<section class="resume-section" id="projects">
    <div class="resume-section-content fade-in">
        <h2 class="section-heading">Projets</h2>

        <div class="projects-grid">
            {
                projects.map((p) => (
                    <a
                        class="project-card"
                        href={p.url}
                        target="_blank"
                        rel="noopener"
                        aria-label={`Voir le projet ${p.title}`}
                    >
                        <Image
                            src={imageMap[p.img]}
                            alt={p.title}
                            width={380}
                            height={190}
                            class="card-img"
                        />
                        <div class="card-overlay" />
                        <div class="card-info">
                            <span class="card-title">{p.title}</span>
                            <span class="card-cta">
                                Voir le projet
                                <svg viewBox="0 0 24 24" fill="currentColor" width="0.9em" height="0.9em" aria-hidden="true">
                                    <path d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42L17.59 5H14V3zM5 5h6v2H7v10h10v-4h2v6H5V5z"/>
                                </svg>
                            </span>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<style>
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1.5rem;
    }

    .project-card {
        position: relative;
        display: block;
        border-radius: 0.625rem;
        overflow: hidden;
        text-decoration: none;
        box-shadow:
            0 2px 8px rgba(0, 0, 0, 0.1),
            0 0 0 1px rgba(0, 0, 0, 0.05);
        transition:
            transform 0.35s ease,
            box-shadow 0.35s ease;
    }
    .project-card:hover {
        transform: translateY(-6px);
        box-shadow:
            0 20px 48px rgba(0, 0, 0, 0.2),
            0 0 0 1px rgba(0, 0, 0, 0.06);
    }

    /* Image is in normal flow — its size defines the card height */
    .card-img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 8;
        object-fit: cover;
        transition: transform 0.55s ease;
    }
    .project-card:hover .card-img {
        transform: scale(1.07);
    }

    /* Dark gradient at rest */
    .card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.72) 0%,
            rgba(0, 0, 0, 0.08) 55%,
            transparent 100%
        );
        transition: background 0.4s ease;
    }
    .project-card:hover .card-overlay {
        background: linear-gradient(
            to top,
            rgba(13, 71, 161, 0.92) 0%,
            rgba(21, 101, 192, 0.65) 55%,
            rgba(25, 118, 210, 0.25) 100%
        );
    }

    .card-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1.1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .card-title {
        color: #fff;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: 0.04rem;
        text-transform: uppercase;
        line-height: 1.2;
        transform: translateY(0);
        transition: transform 0.35s ease;
    }
    .project-card:hover .card-title {
        transform: translateY(-0.35rem);
    }

    .card-cta {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06rem;
        text-transform: uppercase;
        opacity: 0;
        transform: translateY(0.5rem);
        transition:
            opacity 0.35s ease,
            transform 0.35s ease;
    }
    .project-card:hover .card-cta {
        opacity: 1;
        transform: translateY(0);
    }

    /* Touch devices: no hover, show CTA permanently */
    @media (hover: none) {
        .card-cta {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>