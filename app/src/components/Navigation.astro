<!-- Desktop only: floating tab to reopen the nav -->
<button class="nav-reopen-btn" aria-label="Ouvrir la navigation">
    <svg viewBox="0 0 24 24" fill="currentColor" width="1em" height="1em" aria-hidden="true">
        <path d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
    </svg>
</button>

<style>
    #sideNav {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-width);
        height: 100vh;
        background: linear-gradient(
            160deg,
            var(--primary-darker) 0%,
            var(--primary) 60%,
            var(--primary-dark) 100%
        );
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.2);
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 100;
        overflow-y: auto;
    }

    .nav-mobile-bar {
        display: none;
    }

    .nav-toggle {
        background: none;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: var(--radius);
        color: rgba(255, 255, 255, 0.85);
        padding: 0.35rem 0.5rem;
        cursor: pointer;
        line-height: 0;
        transition:
            border-color var(--ease),
            color var(--ease);
    }
    .nav-toggle:hover {
        border-color: rgba(255, 255, 255, 0.7);
        color: var(--white);
    }

    .nav-links {
        list-style: none;
        padding: 0;
    }
    .nav-links li {
        margin: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nav-links li:first-child {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav-links a {
        display: block;
        padding: 0.8rem 1.5rem;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.14rem;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        position: relative;
        text-align: center;
        transition:
            color var(--ease),
            padding-left var(--ease);
    }
    .nav-links a::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 0;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 2px;
        transition: height var(--ease);
    }
    .nav-links a:hover,
    .nav-links a:global(.active) {
        color: var(--white);
        padding-left: 2.1rem;
    }
    .nav-links a:hover::before,
    .nav-links a:global(.active)::before {
        height: 1.1rem;
    }

    /* Desktop collapse button */
    .nav-collapse-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        position: absolute;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: var(--radius);
        color: rgba(255, 255, 255, 0.7);
        width: 2rem;
        height: 2rem;
        cursor: pointer;
        transition:
            background var(--ease),
            color var(--ease);
    }
    .nav-collapse-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        color: var(--white);
    }

    /* Floating reopen tab */
    .nav-reopen-btn {
        position: fixed;
        top: 50%;
        left: 0;
        transform: translateY(-50%);
        z-index: 101;
        background: var(--primary);
        border: none;
        border-radius: 0 var(--radius) var(--radius) 0;
        color: var(--white);
        width: 1.5rem;
        height: 3rem;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
        transition: background var(--ease);
    }
    .nav-reopen-btn:hover {
        background: var(--primary-dark);
    }

    @media (max-width: 991px) {
        #sideNav {
            width: 100%;
            height: var(--navbar-height);
            overflow: hidden;
            justify-content: flex-start;
            flex-direction: column;
            transition: height 0.3s ease;
        }
        #sideNav:global(.open) {
            height: auto;
            overflow: visible;
        }

        .nav-mobile-bar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            height: var(--navbar-height);
            padding: 0 1rem;
            flex-shrink: 0;
        }

        .nav-links {
            display: none;
        }
        #sideNav:global(.open) .nav-links {
            display: block;
        }

        .nav-collapse-btn {
            display: none;
        }
    }
</style>

<script>
    const collapseBtn = document.querySelector('.nav-collapse-btn')!;
    const reopenBtn = document.querySelector('.nav-reopen-btn')!;

    function setCollapsed(collapsed: boolean) {
        document.body.classList.toggle('nav-collapsed', collapsed);
        localStorage.setItem('navCollapsed', String(collapsed));
    }

    // Restore saved state
    if (localStorage.getItem('navCollapsed') === 'true') {
        document.body.classList.add('nav-collapsed');
    }

    collapseBtn.addEventListener('click', () => setCollapsed(true));
    reopenBtn.addEventListener('click', () => setCollapsed(false));
</script>