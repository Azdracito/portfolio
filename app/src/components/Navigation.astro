<style>
    /* ===== Desktop ===== */
    #sideNav {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-width);
        height: 100vh;
        background: var(--primary);
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.2);
        display: flex;
        flex-direction: column;
        justify-content: center;
        z-index: 100;
        overflow-y: auto;
    }

    .nav-mobile-bar { display: none; }

    .nav-links {
        list-style: none;
        padding: 0;
    }
    .nav-links li {
        margin: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nav-links li:first-child {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nav-links a {
        display: block;
        padding: 0.8rem 1.5rem;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.14rem;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;
        position: relative;
        text-align: center;
        transition: color var(--ease), padding-left var(--ease);
    }
    .nav-links a::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3px;
        height: 0;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 2px;
        transition: height var(--ease);
    }
    .nav-links a:hover,
    .nav-links a:global(.active) {
        color: var(--white);
        padding-left: 2.1rem;
    }
    .nav-links a:hover::before,
    .nav-links a:global(.active)::before {
        height: 1.1rem;
    }

    .nav-footer {
        position: absolute;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .nav-theme-btn,
    .nav-collapse-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: var(--radius);
        color: rgba(255, 255, 255, 0.7);
        width: 2rem;
        height: 2rem;
        cursor: pointer;
        transition: background var(--ease), color var(--ease);
    }
    .nav-theme-btn:hover,
    .nav-collapse-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        color: var(--white);
    }

    .icon-moon { display: none; }
    .icon-sun  { display: block; }
    :global(html.dark) .icon-moon { display: block; }
    :global(html.dark) .icon-sun  { display: none; }

    .nav-reopen-btn {
        position: fixed;
        top: 50%;
        left: 0;
        transform: translateY(-50%);
        z-index: 101;
        background: var(--primary);
        border: none;
        border-radius: 0 var(--radius) var(--radius) 0;
        color: var(--white);
        width: 1.5rem;
        height: 3rem;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        box-shadow: 2px 0 8px rgba(0, 0, 0, 0.2);
        transition: background var(--ease);
    }
    .nav-reopen-btn:hover { background: var(--primary-dark); }

    .nav-backdrop { display: none; }

    /* ===== Mobile ===== */
    @media (max-width: 991px) {
        #sideNav {
            width: 100%;
            height: var(--navbar-height);
            overflow: visible;
            justify-content: flex-start;
            flex-direction: column;
            transition: none;
        }

        .nav-mobile-bar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.5rem;
            height: var(--navbar-height);
            padding: 0 1rem;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        /* Hamburger button */
        .nav-toggle {
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 5px;
            border-radius: var(--radius);
        }

        .bar {
            display: block;
            width: 22px;
            height: 2px;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 2px;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        /* Bars → ✕ */
        #sideNav:global(.open) .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        #sideNav:global(.open) .bar:nth-child(2) { opacity: 0; transform: scaleX(0); }
        #sideNav:global(.open) .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        /* Slide-down drawer */
        .nav-drawer {
            position: absolute;
            top: var(--navbar-height);
            left: 0;
            right: 0;
            background: var(--primary);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
            padding-bottom: 0.5rem;
            opacity: 0;
            transform: translateY(-6px);
            pointer-events: none;
            transition: opacity 0.28s ease, transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #sideNav:global(.open) .nav-drawer {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }

        /* Staggered nav items */
        .nav-links li {
            border-color: rgba(255, 255, 255, 0.08);
            opacity: 0;
            transform: translateY(-8px);
            transition: opacity 0.22s ease, transform 0.22s ease;
        }
        #sideNav:global(.open) .nav-links li               { opacity: 1; transform: none; }
        #sideNav:global(.open) .nav-links li:nth-child(1)  { transition-delay: 0.06s; }
        #sideNav:global(.open) .nav-links li:nth-child(2)  { transition-delay: 0.11s; }
        #sideNav:global(.open) .nav-links li:nth-child(3)  { transition-delay: 0.16s; }
        #sideNav:global(.open) .nav-links li:nth-child(4)  { transition-delay: 0.21s; }
        #sideNav:global(.open) .nav-links li:nth-child(5)  { transition-delay: 0.26s; }
        #sideNav:global(.open) .nav-links li:nth-child(6)  { transition-delay: 0.31s; }

        .nav-footer { display: none; }
        .nav-reopen-btn { display: none !important; }

        /* Backdrop */
        .nav-backdrop {
            display: block;
            position: fixed;
            top: var(--navbar-height);
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(2px);
            -webkit-backdrop-filter: blur(2px);
            z-index: 99;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.28s ease;
        }
        :global(body.nav-open) .nav-backdrop {
            opacity: 1;
            pointer-events: auto;
        }
    }
</style>

<script>
    const sidebar   = document.getElementById('sideNav')!;
    const toggle    = document.querySelector<HTMLButtonElement>('.nav-toggle')!;
    const backdrop  = document.querySelector('.nav-backdrop')!;
    const collapseBtn = document.querySelector('.nav-collapse-btn')!;
    const reopenBtn   = document.querySelector('.nav-reopen-btn')!;
    const themeToggles = document.querySelectorAll('.nav-theme-btn');

    function openNav() {
        sidebar.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.classList.add('nav-open');
    }
    function closeNav() {
        sidebar.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('nav-open');
    }

    toggle.addEventListener('click', () =>
        sidebar.classList.contains('open') ? closeNav() : openNav()
    );
    backdrop.addEventListener('click', closeNav);
    document.querySelectorAll('.nav-links a').forEach((a) =>
        a.addEventListener('click', closeNav)
    );

    function setCollapsed(collapsed: boolean) {
        document.body.classList.toggle('nav-collapsed', collapsed);
        localStorage.setItem('navCollapsed', String(collapsed));
    }
    function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    }

    if (localStorage.getItem('navCollapsed') === 'true') {
        document.body.classList.add('nav-collapsed');
    }

    collapseBtn.addEventListener('click', () => setCollapsed(true));
    reopenBtn.addEventListener('click',   () => setCollapsed(false));
    themeToggles.forEach((btn) => btn.addEventListener('click', toggleTheme));
</script>
